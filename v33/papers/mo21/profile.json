    0,
    0,
    230
   ]
  },
  "magenta": {
   "strict": "(r > 170) & (b > 150) & (g < 110)",
   "relaxed": "(r > 150) & (b > 120) & (g < 120)",
   "overlay": [
    220,
    0,
    220
   ]
  }
 },
