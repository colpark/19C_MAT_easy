    "green"
   ],
   [
    "r == mx and b - g > 60",
    "magenta"
   ],
   [
    "r == mx",
    "red"
   ],
   [
    "b == mx and r > g + 40",
    "magenta"
   ],
   [
    "b == mx",
    "blue"
   ]
  ]
 },
