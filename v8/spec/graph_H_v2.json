{
  "graph_id": "H_hull_stability_v2",
  "claim_type": "H",
  "claim_template": "The crystalline phase in this sample lies within 50 meV/atom of the convex hull.",
  "description": "A chain: the FM must evaluate the polymorph the sample actually holds, so S2 depends on the settled identification S1g. Kit D adds the remeasure path (S1d, S1e, S1f, as graph R v2) and the settle node S1g, and drops DFT escalation (19C scope).",
  "constants": {
    "D_accept": 25,
    "D_undecisive": 9,
    "threshold": 0.05,
    "band": 0.02,
    "exemplar_margin_factor": 2,
    "budget_min": 180
  },
  "roles": {
    "plan": "S0",
    "window": "S1a",
    "measure": "S1b",
    "identify": "S1c",
    "remeasure_plan": "S1d",
    "remeasure": "S1e",
    "reidentify": "S1f",
    "settle": "S1g",
    "prior": "S2",
    "decide": "S3"
  },
  "final": "S3",
  "necessity_nodes": [
    "S1a",
    "S1b",
    "S1c",
    "S2"
  ],
  "nodes": [
    {
      "id": "S0",
      "label": "decompose",
      "goal": "Split the claim into the subgoals it needs: which polymorph the sample holds, then how far that polymorph lies above the hull.",
      "module": "plan",
      "inputs": [
        {
          "name": "claim",
          "type": "text",
          "from": "task.claim"
        },
        {
          "name": "library",
          "type": "structures",
          "from": "task.library"
        }
      ],
      "outputs": [
        {
          "name": "subgoals",
          "type": "list[text]"
        }
      ],
      "null_output": {
        "subgoals": null
      },
      "accept": {
        "kind": "always"
      }
    },
    {
      "id": "S1a",
      "label": "predict window",
      "goal": "Simulate every library polymorph and find the cheapest measurement plan whose expected separation reaches D_accept against every other polymorph.",
      "module": "simulator",
      "inputs": [
        {
          "name": "library",
          "type": "structures",
          "from": "task.library"
        },
        {
          "name": "m0",
          "type": "measurement",
          "from": "task.m0"
        },
        {
          "name": "budget",
          "type": "float",
          "unit": "min",
          "from": "const.budget_min"
        }
      ],
      "outputs": [
        {
          "name": "window",
          "type": "interval_deg",
          "unit": "deg"
        },
        {
          "name": "plan",
          "type": "list[measurement_request]"
        },
        {
          "name": "predicted_D",
          "type": "float"
        },
        {
          "name": "predicted_cost_min",
          "type": "float",
          "unit": "min"
        }
      ],
      "null_output": {
        "window": null,
        "plan": [],
        "predicted_D": null,
        "predicted_cost_min": 0
      },
      "accept": {
        "kind": "threshold",
        "field": "predicted_D",
        "op": ">=",
        "value_from": "const.D_accept"
      },
      "cost": "free (simulation)"
    },
    {
      "id": "S1b",
      "label": "measure",
      "goal": "Acquire the measurements of the plan.",
      "module": "instrument",
      "inputs": [
        {
          "name": "plan",
          "type": "list[measurement_request]",
          "from": "S1a.plan"
        }
      ],
      "outputs": [
        {
          "name": "measurements",
          "type": "list[measurement_id]"
        },
        {
          "name": "cost_min",
          "type": "float",
          "unit": "min"
        }
      ],
      "null_output": {
        "measurements": [],
        "cost_min": 0
      },
      "accept": {
        "kind": "always"
      },
      "cost": "points times seconds per step over 60, plus 5 minutes overhead, per measurement"
    },
    {
      "id": "S1c",
      "label": "identify",
      "goal": "Fit every library polymorph to all measurements, the free scan included, with nuisances free, and report the favoured polymorph and its separation D from the best other polymorph.",
      "module": "fit",
      "inputs": [
        {
          "name": "m0",
          "type": "measurement",
          "from": "task.m0"
        },
        {
          "name": "measurements",
          "type": "list[measurement_id]",
          "from": "S1b.measurements"
        },
        {
          "name": "library",
          "type": "structures",
          "from": "task.library"
        }
      ],
      "outputs": [
        {
          "name": "phase",
          "type": "enum[library]"
        },
        {
          "name": "runner_up",
          "type": "enum[library]"
        },
        {
          "name": "D",
          "type": "float"
        }
      ],
      "null_output": {
        "phase": null,
        "runner_up": null,
        "D": null
      },
      "accept": {
        "kind": "threshold",
        "field": "D",
        "op": ">=",
        "value_from": "const.D_accept"
      },
      "cost": "free (fit)"
    },
    {
      "id": "S1d",
      "label": "re-plan",
      "goal": "When S1c is not decisive, simulate again with the data already taken and find the cheapest plan within the remaining budget whose worst-case expected separation, nuisances free, reaches D_accept.",
      "module": "simulator",
      "optional": true,
      "trigger": {
        "node": "S1c",
        "accepted": false
      },
      "fallback_for": "S1a",
      "inputs": [
        {
          "name": "library",
          "type": "structures",
          "from": "task.library"
        },
        {
          "name": "m0",
          "type": "measurement",
          "from": "task.m0"
        },
        {
          "name": "measurements",
          "type": "list[measurement_id]",
          "from": "S1b.measurements"
        },
        {
          "name": "budget",
          "type": "float",
          "unit": "min",
          "from": "const.budget_min"
        }
      ],
      "outputs": [
        {
          "name": "window",
          "type": "interval_deg",
          "unit": "deg"
        },
        {
          "name": "plan",
          "type": "list[measurement_request]"
        },
        {
          "name": "predicted_D",
          "type": "float"
        },
        {
          "name": "predicted_cost_min",
          "type": "float",
          "unit": "min"
        }
      ],
      "null_output": {
        "window": null,
        "plan": [],
        "predicted_D": null,
        "predicted_cost_min": 0
      },
      "accept": {
        "kind": "threshold",
        "field": "predicted_D",
        "op": ">=",
        "value_from": "const.D_accept"
      },
      "cost": "free (simulation)"
    },
    {
      "id": "S1e",
      "label": "measure again",
      "goal": "Acquire the measurements of the new plan.",
      "module": "instrument",
      "optional": true,
      "trigger": {
        "node": "S1c",
        "accepted": false
      },
      "fallback_for": "S1b",
      "inputs": [
        {
          "name": "plan",
          "type": "list[measurement_request]",
          "from": "S1d.plan"
        }
      ],
      "outputs": [
        {
          "name": "measurements",
          "type": "list[measurement_id]"
        },
        {
          "name": "cost_min",
          "type": "float",
          "unit": "min"
        }
      ],
      "null_output": {
        "measurements": [],
        "cost_min": 0
      },
      "accept": {
        "kind": "always"
      },
      "cost": "points times seconds per step over 60, plus 5 minutes overhead, per measurement"
    },
    {
      "id": "S1f",
      "label": "re-identify",
      "goal": "Fit every library polymorph to all measurements, the free scan and both rounds included, with nuisances free.",
      "module": "fit",
      "optional": true,
      "trigger": {
        "node": "S1c",
        "accepted": false
      },
      "fallback_for": "S1c",
      "inputs": [
        {
          "name": "m0",
          "type": "measurement",
          "from": "task.m0"
        },
        {
          "name": "measurements",
          "type": "list[measurement_id]",
          "from": "S1b.measurements"
        },
        {
          "name": "measurements2",
          "type": "list[measurement_id]",
          "from": "S1e.measurements"
        },
        {
          "name": "library",
          "type": "structures",
          "from": "task.library"
        }
      ],
      "outputs": [
        {
          "name": "phase",
          "type": "enum[library]"
        },
        {
          "name": "runner_up",
          "type": "enum[library]"
        },
        {
          "name": "D",
          "type": "float"
        }
      ],
      "null_output": {
        "phase": null,
        "runner_up": null,
        "D": null
      },
      "accept": {
        "kind": "threshold",
        "field": "D",
        "op": ">=",
        "value_from": "const.D_accept"
      },
      "cost": "free (fit)"
    },
    {
      "id": "S1g",
      "label": "settle identity",
      "goal": "Take the accepted identification: the remeasure result when it ran and reached D_accept, else the first identification when it reached D_accept, else none.",
      "module": "rule",
      "fn": "settle_identity",
      "params": {
        "entries": [
          [
            "S1f",
            "phase2",
            "D2"
          ],
          [
            "S1c",
            "phase",
            "D"
          ]
        ]
      },
      "inputs": [
        {
          "name": "phase",
          "type": "enum[library]",
          "from": "S1c.phase",
          "required": false
        },
        {
          "name": "D",
          "type": "float",
          "from": "S1c.D",
          "required": false
        },
        {
          "name": "phase2",
          "type": "enum[library]",
          "from": "S1f.phase",
          "required": false
        },
        {
          "name": "D2",
          "type": "float",
          "from": "S1f.D",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "phase",
          "type": "enum[library]"
        },
        {
          "name": "D",
          "type": "float"
        },
        {
          "name": "D_best",
          "type": "float"
        },
        {
          "name": "source",
          "type": "text"
        }
      ],
      "null_output": {
        "phase": null,
        "D": null,
        "D_best": null,
        "source": null
      },
      "accept": {
        "kind": "threshold",
        "field": "D",
        "op": ">=",
        "value_from": "const.D_accept"
      },
      "cost": "free (rule)"
    },
    {
      "id": "S2",
      "label": "infer hull distance (FM)",
      "goal": "Predict the energy above the MP DFT hull of the settled polymorph with the FM, and report its margin from the threshold.",
      "module": "fm",
      "inputs": [
        {
          "name": "phase",
          "type": "enum[library]",
          "from": "S1g.phase"
        }
      ],
      "outputs": [
        {
          "name": "hull_distance",
          "type": "float",
          "unit": "eV/atom"
        },
        {
          "name": "decomposition",
          "type": "list[phase]"
        },
        {
          "name": "stated_error",
          "type": "float",
          "unit": "eV/atom"
        },
        {
          "name": "margin",
          "type": "float",
          "unit": "eV/atom"
        }
      ],
      "null_output": {
        "hull_distance": null,
        "decomposition": null,
        "stated_error": null,
        "margin": null
      },
      "accept": {
        "kind": "threshold",
        "field": "margin",
        "op": ">=",
        "value_from": "const.band"
      },
      "cost": "free (amortized inference)"
    },
    {
      "id": "S3",
      "label": "decide",
      "goal": "SUPPORTED if the settled polymorph lies at most threshold above the hull, REFUTED if above, CANNOT_TELL if identification is not decisive or the FM margin lies inside the band.",
      "module": "rule",
      "fn": "H_within_threshold",
      "params": {
        "identify": "S1g",
        "prior": "S2"
      },
      "inputs": [
        {
          "name": "phase",
          "type": "enum[library]",
          "from": "S1g.phase",
          "required": false
        },
        {
          "name": "hull_distance",
          "type": "float",
          "from": "S2.hull_distance",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "verdict",
          "type": "enum[SUPPORTED,REFUTED,CANNOT_TELL]"
        },
        {
          "name": "reason",
          "type": "text"
        }
      ],
      "null_output": {
        "verdict": "CANNOT_TELL",
        "reason": "blocked"
      },
      "accept": {
        "kind": "always"
      }
    }
  ]
}