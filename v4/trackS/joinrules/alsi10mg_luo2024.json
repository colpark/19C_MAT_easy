{
 "dataset": "alsi10mg_luo2024",
 "_source": "readme.txt in the high-magnification zip (32 samples = processing parameter sets 1-32, small hatch group; per sample a 2000x overview, an annotated overview and four 5000x images a-d) and 'AlSi10Mg PSP feature table.xlsx' (P, v, t, h, LED, VED per set). The annotated overview carries author drawings and is not a measurement image. Round 2 (David, 2026-10-07): all 60 processing sets (sets 33-60 vary hatch spacing; SEM images exist for sets 1-32 only); property series ordered by VED = P/(v h t), fixed before any UTS of sets 33-60 was computed.",
 "rules": [
  {
   "name": "docs",
   "path_regex": "(?i)(readme|\\.pptx$)",
   "role": "document"
  },
  {
   "name": "annotated overview",
   "path_regex": "images/[^/]*_Sample(?P<set>\\d+)-Overview_Annotated\\.tif$",
   "role": "other",
   "set": {
    "kind": "annotated"
   }
  },
  {
   "name": "overview 2000x",
   "path_regex": "images/[^/]*_Sample(?P<set>\\d+)-Overview\\.tif$",
   "role": "sem_image",
   "set": {
    "kind": "overview_2000x"
   }
  },
  {
   "name": "fields 5000x",
   "path_regex": "images/[^/]*_Sample(?P<set>\\d+)-(?P<field>[a-d])\\.tif$",
   "role": "sem_image",
   "set": {
    "kind": "field_5000x"
   }
  },
  {
   "name": "stress-strain",
   "path_regex": "(?i)stress-strain curves/.*\\.(xlsx|csv)$",
   "role": "curve"
  },
  {
   "name": "tables",
   "path_regex": "\\.xlsx$",
   "role": "metadata"
  },
  {
   "name": "morphology csv",
   "path_regex": "(?i)(morphology|XCT_pore).*\\.csv$",
   "role": "metadata"
  },
  {
   "name": "archives",
   "path_regex": "^files/[^/]*\\.zip$",
   "role": "other"
  }
 ],
