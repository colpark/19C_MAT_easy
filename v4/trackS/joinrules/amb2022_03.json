{
 "dataset": "amb2022_03",
 "_source": "AMB2022-03-Microstructure Measurements.pdf (Table 1, Figure 1, folder layout) and 2775_README.txt. Track code L<case digits><repeat> (L-0r for the baseline case 0, some names drop the L, one uses '-L'); 'bottom' marks the second field of the deep case-1.1 tracks. Cases ordered by areal energy density P/(v D) in J/mm2 (computed from Table 1, fixed before any measurement).",
 "rules": [
  {
   "name": "docs",
   "path_regex": "(README|\\.pdf$)",
   "role": "document"
  },
  {
   "name": "track EBSD export",
   "path_regex": "Traces/.*Map Data \\d+[_-](?P<track>L?-?\\d{2,3})(?P<part> bottom)?\\.ctf$",
   "role": "ebsd_export"
  },
  {
   "name": "track EBSD h5oina",
   "path_regex": "Traces/.*Map Data \\d+[_-](?P<track>L?-?\\d{2,3})(?P<part> bottom)?\\.h5oina$",
   "role": "ebsd_export"
  },
  {
   "name": "track EBSD maps",
   "path_regex": "Traces/.*Map Data \\d+[_-](?P<track>L?-?\\d{2,3})(?P<part> bottom)?-(?P<map>[^/]+)\\.tif$",
   "role": "ebsd_map"
  },
  {
   "name": "track EDS maps",
   "path_regex": "Traces/.*_Trace (?P<track>L-?\\d{2,3}) [^/]*EDS map_(?P<line>[^/]+)\\.tiff?$",
   "role": "eds_map"
  },
  {
   "name": "L112 montage (P3)",
   "path_regex": "Traces/[^/]*P3-112[^/]*/.*\\.(tif|tiff|ctf|h5oina)$",
   "role": "ebsd_map",
   "set": {
    "track": "L112",
    "part": "montage"
   }
  },
  {
   "name": "pad EBSD",
   "path_regex": "Pads/.*\\.(ctf|h5oina)$",
   "role": "ebsd_export",
   "set": {
    "case": "pad"
   }
  },
  {
   "name": "pad maps",
   "path_regex": "Pads/.*Map Data-[^/]+\\.tif$",
   "role": "ebsd_map",
   "set": {
    "case": "pad"
   }
  },
  {
   "name": "pad EDS maps",
   "path_regex": "Pads/.*EDS map[^/]*\\.tiff?$",
   "role": "eds_map",
   "set": {
    "case": "pad"
   }
  },
  {
   "name": "csv exports",
   "path_regex": "\\.csv$",
   "role": "ebsd_export"
  },
  {
   "name": "raw EBSD patterns",
   "path_regex": "\\.(ebsp|uebsp)$",
   "role": "ebsd_patterns"
  },
  {
   "name": "raw EDS cubes",
   "path_regex": "\\.raw$",
   "role": "eds_spectrum"
  },
  {
   "name": "AZtec project",
   "path_regex": "\\.(oipx|dat)$",
   "role": "other"
  }
 ],
