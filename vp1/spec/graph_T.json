          "required": false
        },
        {
          "name": "energies",
          "type": "map[name,float]",
          "from": "S2.energies",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "verdict",
          "type": "enum[SUPPORTED,REFUTED,CANNOT_TELL]"
        },
        {
          "name": "reason",
          "type": "text"
        },
        {
          "name": "margin_used",
          "type": "float",
          "unit": "eV/atom"
        }
      ],
      "null_output": {
        "verdict": "CANNOT_TELL",
        "reason": "blocked",
        "margin_used": null
      },
      "accept": {
        "kind": "always"
      }
    }
  ]
}